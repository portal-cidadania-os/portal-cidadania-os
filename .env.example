# ============================================================
# portal-cidadania-os — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local ou .env.production no git.
# ============================================================

# Supabase — Dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Supabase — Dashboard -> Settings -> API -> anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY

# Supabase — Dashboard -> Settings -> API -> service_role (secret)
# ATENÇÃO: nunca expor no client-side (sem prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# Supabase — Dashboard -> Settings -> Database -> Connection string (URI mode)
# NUNCA versionar esta variável — contém senha do banco
PORTAL_CIDADANIA_SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres
